		"sources": "https://github.com/brainage04/BetterVillagerTrades"
	},
	"license": "MIT",
	"icon": "assets/bettervillagertrades/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.brainage04.bettervillagertrades.fabric.BetterVillagerTradesFabric"
		]
	},
	"mixins": [
		"bettervillagertrades.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
